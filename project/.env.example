# --- data / research ---
SEC_USER_AGENT="Your Name your@email.com"   # SEC EDGAR requires a contact
DRIFTREV_DATA_DIR=./data                     # /data in Docker
DRIFTREV_SNAPSHOT_URL=                       # direct-download zip for "file" mode
DRIFTREV_MAX_TICKERS=0                       # 0 = all; 50 for a smoke test
DRIFTREV_MARKET=us                           # us | de (de is planned, R7.2+)
DRIFTREV_SCHEDULE_TIME=22:30                 # local exchange time of DRIFTREV_MARKET, Mon-Fri

# --- API / MCP auth ---
DRIFTREV_API_TOKEN=change-me-long-random
DRIFTREV_ALLOW_NO_AUTH=false                 # true only for local dev

# --- broker (paper by default) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
DRIFTREV_ALLOW_ORDERS=false                  # must be true to submit orders

# --- agent ---
XAI_API_KEY=
XAI_MODEL=grok-4
DRIFTREV_API_URL=http://localhost:8000

# --- notifications (R3, optional; empty = disabled) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DRIFTREV_WEBHOOK_URL=                        # JSON POST: {"text", "signals", "data_through", "regime"}
NOTIFY_MIN_TIER=BUY                          # STRONG_BUY | BUY | WATCH ...
