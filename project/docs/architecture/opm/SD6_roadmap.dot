// SD6 · Roadmap: PLANNED processes (dotted) and where they attach to the implemented model.
// Rule: a planned thing becomes solid only when its code, test and OPL sentence land together.
digraph SD6 {
  graph [rankdir=LR, fontname="Helvetica", fontsize=14, labelloc=t, nodesep=0.4, ranksep=0.8,
         label="SD6 · Roadmap · dotted = PLANNED, solid = implemented anchor"];
  node  [fontname="Helvetica", fontsize=10, style=filled, fillcolor="#e6e6e6"];
  edge  [fontname="Helvetica", fontsize=9];

  // implemented anchors
  acquiring    [shape=ellipse, fillcolor="#cfe2ff", label="Acquiring (SD1)"];
  transforming [shape=ellipse, label="Transforming (SD2)"];
  researching  [shape=ellipse, fillcolor="#ffe0b3", label="Researching (SD3)"];
  signalling   [shape=ellipse, fillcolor="#fff3b0", label="Signalling (SD4)"];
  serving      [shape=ellipse, fillcolor="#d1f0d1", label="Serving (SD5)"];
  universe     [shape=box, fillcolor="#cfe2ff", label="universe"];
  report       [shape=box, fillcolor="#ffe0b3", label="Backtest Report"];
  book         [shape=box, fillcolor="#fff3b0", label="Signal Book"];

  // planned things
  r1 [shape=ellipse, fillcolor="#cfe2ff", label="R1 Loading Historical Membership (DONE, now in SD1/SD2)\n(S&P add/remove tables + delisted prices;\nreduces survivorship bias)"];
  r1o [shape=box, fillcolor="#cfe2ff", label="membership_history\n(ticker, index, start, end)"];
  r2 [shape=ellipse, style="filled", fillcolor="#ffe0b3", label="R2 Walk-forward Retraining\n(implemented in SD3: expanding window,\nyearly refit, stitched OOS equity)"];
  r3 [shape=ellipse, fillcolor="#d1f0d1", label="R3 Notifying ✓\n(implemented: SD5, driftrev.notify)"];
  r4 [shape=ellipse, fillcolor="#e6e6e6", label="R4 Classifying Filing Text ✓\n(implemented: SD2.1, driftrev.filing_text)"];
  r5 [shape=ellipse, fillcolor="#d1f0d1", label="R5 Cloud Deploying ✓ (image on GHCR + manifests;\nactual deploy is a manual step)"];
  r6 [shape=ellipse, style="filled,dotted", fillcolor="#f2f2f2", label="R6 Confirming Intraday Entry\n(guide Entry B: reclaim prior high /\nVWAP with intraday bars)"];

  r1 -> r1o; r1o -> acquiring [arrowhead=odot]; r1 -> universe [dir=both];
  researching -> r2 [style=dashed]; r2 -> report [dir=both];
  signalling -> r3 [style=dashed, label="[after publish]"]; book -> r3 [arrowhead=odot];
  r4 -> transforming [style=dashed];
  r5 -> serving [dir=both];
  r6 -> signalling [style=dashed];
}
