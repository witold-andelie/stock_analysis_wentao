// SD6 · Roadmap: PLANNED processes (dotted) and where they attach to the implemented model.
// Rule: a planned thing becomes solid only when its code, test and OPL sentence land together.
digraph SD6 {
  graph [rankdir=LR, fontname="Helvetica", fontsize=14, labelloc=t, nodesep=0.4, ranksep=0.8,
         label="SD6 · Roadmap · dotted = PLANNED, solid = implemented anchor"];
  node  [fontname="Helvetica", fontsize=10, style=filled, fillcolor="#e6e6e6"];
  edge  [fontname="Helvetica", fontsize=9];

  // implemented anchors
  acquiring    [shape=ellipse, fillcolor="#cfe2ff", label="Acquiring (SD1)"];
  transforming [shape=ellipse, label="Transforming (SD2)"];
  researching  [shape=ellipse, fillcolor="#ffe0b3", label="Researching (SD3)"];
  signalling   [shape=ellipse, fillcolor="#fff3b0", label="Signalling (SD4)"];
  serving      [shape=ellipse, fillcolor="#d1f0d1", label="Serving (SD5)"];
  universe     [shape=box, fillcolor="#cfe2ff", label="universe"];
  report       [shape=box, fillcolor="#ffe0b3", label="Backtest Report"];
  book         [shape=box, fillcolor="#fff3b0", label="Signal Book"];

  // planned things
  r1 [shape=ellipse, fillcolor="#cfe2ff", label="R1 Loading Historical Membership (DONE, now in SD1/SD2)\n(S&P add/remove tables + delisted prices;\nreduces survivorship bias)"];
  r1o [shape=box, fillcolor="#cfe2ff", label="membership_history\n(ticker, index, start, end)"];
  r2 [shape=ellipse, style="filled", fillcolor="#ffe0b3", label="R2 Walk-forward Retraining\n(implemented in SD3: expanding window,\nyearly refit, stitched OOS equity)"];
  r3 [shape=ellipse, fillcolor="#d1f0d1", label="R3 Notifying ✓\n(implemented: SD5, driftrev.notify)"];
  r4 [shape=ellipse, fillcolor="#e6e6e6", label="R4 Classifying Filing Text ✓\n(implemented: SD2.1, driftrev.filing_text)"];
  r5 [shape=ellipse, fillcolor="#d1f0d1", label="R5 Cloud Deploying ✓ (image on GHCR + manifests;\nactual deploy is a manual step)"];
  r6 [shape=ellipse, style="filled,dotted", fillcolor="#f2f2f2", label="R6 Confirming Intraday Entry\n(guide Entry B: reclaim prior high /\nVWAP with intraday bars)"];

  r1 -> r1o; r1o -> acquiring [arrowhead=odot]; r1 -> universe [dir=both];
  researching -> r2 [style=dashed]; r2 -> report [dir=both];
  signalling -> r3 [style=dashed, label="[after publish]"]; book -> r3 [arrowhead=odot];
  r4 -> transforming [style=dashed];
  r5 -> serving [dir=both];
  r6 -> signalling [style=dashed];

  // R7 · German equities on Deutsche Börse Xetra (DAX + MDAX + SDAX). Order of delivery: R7.1 → R7.6.
  subgraph cluster_r7 {
    label="R7 · German equities (Xetra: DAX 40 + MDAX 50 + SDAX 70) · mostly implemented"; style="rounded,dotted"; color="#999999";
    node [style="filled,dotted", fillcolor="#f2f2f2"];
    market   [shape=box, style=filled, fillcolor="#e6e6e6", label="Market\n(us | de: MIC, timezone, run time,\ncurrency, benchmarks, cost model,\nindex set, data dir)"];
    r71 [shape=ellipse, style=filled, fillcolor="#ead7ff", label="R7.1 Selecting Market ✓\n(config.Market + DRIFTREV_MARKET;\nUS default unchanged, de refused)"];
    r72 [shape=ellipse, style=filled, fillcolor="#cfe2ff", label="R7.2a Reconstructing German Membership ✓\n(driftrev.de_membership: change grids,\nredirect + alias identity, SDAX via MDAX markers)"];
    r72b [shape=ellipse, style=filled, fillcolor="#cfe2ff", label="R7.2b Resolving German Symbols & Prices ✓\n(Yahoo search → .DE symbol, ISIN;\nHamburg prices for delisted names)"];
    r72o [shape=box, label="membership_history (de)\n(ticker, isin, index, start, end)"];
    r73 [shape=ellipse, style=filled, fillcolor="#cfe2ff", label="R7.3 Loading German Market Series ✓\n(driftrev.de_market: DAX/MDAX/SDAX levels,\nBundesbank 10y Bund; realised-vol proxy)"];
    r74b [shape=ellipse, style=filled, fillcolor="#fff3b0", label="R7.4b German Event Dataset ✓\n(de_pipeline: shared build_all,\ncrash + breakout, 6,445 events)"];
    r74a [shape=ellipse, style=filled, fillcolor="#e6e6e6", label="R7.4a Building German Market Context ✓\n(de_context: spy_*=DAX, iwm_*=SDAX,\nvix=DAX realised vol, Bund lagged)"];
    r74 [shape=ellipse, style=filled, fillcolor="#fff3b0", label="R7.4 German events end to end ✓ (R7.4a-g)\n(price-only family first:\nrolling-window Variant B, EUR liquidity)"];
    r75 [shape=ellipse, label="R7.5 Dating German Releases\n(earnings dates + MAR Art. 17 ad-hoc\nnotices as the 8-K analogue)"];
    r76 [shape=ellipse, style="filled,dashed", fillcolor="#ead7ff", label="R7.6 Trading on Xetra (IBKR, offline-tested)\n(broker bridge for EUR orders,\npaper default, same Order Guard)"];
    xetra [shape=box, style="filled,dashed", fillcolor="#ffffff", label="Deutsche Börse Xetra\n(17:30 CET close)"];
    srcs  [shape=box, style="filled,dashed", fillcolor="#ffffff", label="Public Sources (de), checked 2026-11-22\nWikipedia DAX/MDAX change tables (SDAX: none)\nYahoo .DE prices, indices, earnings dates\nBundesbank daily Bund yield\n(no VDAX; no bulk ad-hoc archive)"];
  }

  r71 -> market [dir=both];
  market -> acquiring [arrowhead=odot]; market -> signalling [arrowhead=odot];
  srcs -> r72 [arrowhead=odot]; r72 -> r72o; r72o -> r72b [arrowhead=odot]; r72b -> universe [dir=both];
  srcs -> r73 [arrowhead=odot]; r73 -> acquiring [style=dashed];
  r72o -> r74 [arrowhead=odot]; r74 -> transforming [style=dashed]; r74a -> r74b [style=dashed]; r74b -> r74 [style=dashed];
  srcs -> r75 [arrowhead=odot]; r75 -> transforming [style=dashed];
  book -> r76 [arrowhead=odot]; xetra -> r76 [arrowhead=odot]; r76 -> serving [style=dashed];
}
